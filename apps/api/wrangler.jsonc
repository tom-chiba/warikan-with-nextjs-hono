{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warikan-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-28",
  // Better Auth が node:crypto などの Node API を使うため必須。
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      // コードは env.DB を参照するため binding は "DB" にする。
      "binding": "DB",
      "database_name": "warikan-db",
      // `wrangler d1 create warikan-db` で払い出されたリモート D1 の ID。
      "database_id": "f27e287a-37de-4f53-9a76-4e8c6ddd709f",
      "migrations_dir": "drizzle",
    },
  ],
  "vars": {
    // web と api を tom-chiba.com のサブドメインに揃え、Cookie を same-site 化している。
    // これによりデフォルトの SameSite=Lax のままクロスオリジン fetch でも Cookie が送られる
    // （SameSite=None / crossSubDomainCookies は不要）。
    "BETTER_AUTH_URL": "https://warikan.api.tom-chiba.com",
    "WEB_ORIGIN": "https://warikan.tom-chiba.com",
    // メール送信元（非機密 / #70）。Resend で検証済みのドメインのアドレスにする。
    // ルートドメイン tom-chiba.com を Resend に登録し、複数の個人開発アプリでローカルパートを
    // 変えて 1 ドメイン枠（無料プランは検証済みドメイン1つまで）を共用する方針。送信専用サブ
    // ドメインによる評判分離より共用を優先する。WEB_ORIGIN（web ドメイン warikan.tom-chiba.com）
    // とは別物なので注意。API キー(RESEND_API_KEY)は機密のため vars には置かず
    // `wrangler secret put` で管理する。
    "RESEND_FROM": "no-reply@tom-chiba.com",
  },
}
