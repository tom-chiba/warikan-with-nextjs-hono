{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warikan-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-28",
  // Better Auth が node:crypto などの Node API を使うため必須。
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      // コードは env.DB を参照するため binding は "DB" にする。
      "binding": "DB",
      "database_name": "warikan-db",
      // `wrangler d1 create warikan-db` で払い出されたリモート D1 の ID。
      "database_id": "f27e287a-37de-4f53-9a76-4e8c6ddd709f",
      "migrations_dir": "drizzle",
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://warikan-api.michiamo-t1.workers.dev",
    "WEB_ORIGIN": "https://warikan-with-nextjs-hono-web.vercel.app",
  },
}
